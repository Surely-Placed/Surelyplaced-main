# Copy to .env.development or .env.production and fill in values.

NODE_ENV=development
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=theplugin
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=surelyplaced

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

FRONTEND_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

WEBINAR_ADMIN_EMAIL=
WEBINAR_ADMIN_PASSWORD=

# Legacy paid-webinar sheet sync (optional — webinar registrants only)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Enrollment requests — GOOGLE_SHEETS_WEBHOOK_URL (Apps Script on enrollment spreadsheet)
# Deploy server/scripts/enrollment-sheet-apps-script.js → Web app → Anyone → /exec URL
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Webinar registration sheet (Apps Script /exec URL — not the spreadsheet edit URL)
WEBINAR_REGISTRATION_SHEET_WEBHOOK_URL=

# Enrollment requests — dedicated spreadsheet (Google Sheets API, not the webinar webhook)
# Sheet: https://docs.google.com/spreadsheets/d/1-hfCSO9-iY4IwYCuH54Ng6xdxFfPYAIX4_Bxd1tT8Fo/edit
ENROLLMENT_SHEET_SPREADSHEET_ID=
ENROLLMENT_SHEET_NAME=Enrollment Requests
# Service account JSON (single-line) or path via GOOGLE_APPLICATION_CREDENTIALS
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
