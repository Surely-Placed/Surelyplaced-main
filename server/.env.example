# Copy to .env.development or .env.production and fill in values.

NODE_ENV=development
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=theplugin
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=surelyplaced

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

FRONTEND_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

WEBINAR_ADMIN_EMAIL=
WEBINAR_ADMIN_PASSWORD=

# Optional dedicated SMS consent CRM sync webhook (falls back to GOOGLE_SHEETS_WEBHOOK_URL)
# SMS_CONSENT_CRM_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Legacy paid-webinar sheet sync (optional — webinar registrants only)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Enrollment requests — GOOGLE_SHEETS_WEBHOOK_URL (Apps Script on enrollment spreadsheet)
# Deploy server/scripts/enrollment-sheet-apps-script.js → Web app → Anyone → /exec URL
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Webinar registration sheet (Apps Script /exec URL — not the spreadsheet edit URL)
WEBINAR_REGISTRATION_SHEET_WEBHOOK_URL=

# Enrollment requests — dedicated spreadsheet (Google Sheets API, not the webinar webhook)
# Sheet: https://docs.google.com/spreadsheets/d/1-hfCSO9-iY4IwYCuH54Ng6xdxFfPYAIX4_Bxd1tT8Fo/edit
ENROLLMENT_SHEET_SPREADSHEET_ID=
ENROLLMENT_SHEET_NAME=Enrollment Requests

# Book a call — dedicated spreadsheet (Apps Script webhook; same as enrollment)
# Sheet: https://docs.google.com/spreadsheets/d/1HAc4LQi_-0L1d3BCXV4bTkrsWQfA2KuUeSAU8W-VKmY/edit
# Deploy server/scripts/booked-call-sheet-apps-script.js → Web app → Anyone → /exec URL
BOOKED_CALL_SHEET_SPREADSHEET_ID=1HAc4LQi_-0L1d3BCXV4bTkrsWQfA2KuUeSAU8W-VKmY
BOOKED_CALL_SHEET_NAME=Booked Calls
BOOKED_CALL_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxeIBEgPOnMgBp3sMm6J02wRVRpFWiKj8P37xER2n_tF2peThd2jHhXLUEHTiz7x3bkpQ/exec
# Optional if Zoom meeting creation fails or Zoom is not configured
BOOK_CALL_FALLBACK_ZOOM_JOIN_URL=
BOOK_CALL_DURATION_MINUTES=30
# Service account JSON (single-line) or path via GOOGLE_APPLICATION_CREDENTIALS
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
